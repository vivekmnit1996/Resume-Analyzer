# Environment Configuration Template
# Copy this file to .env and provide your private API credentials.
# DO NOT commit .env to version control.

# Groq API Key for the grounded LLaMA 3.3 explanation layer
GROQ_API_KEY=your_groq_api_key_here

# Optional: Embedding model override (defaults to sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optional: Job dataset sample size for fast dev mode (set to 0 or leave empty for full 23,425 dataset)
DEV_SAMPLE_SIZE=500
