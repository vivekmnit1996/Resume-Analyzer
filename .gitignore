# ==============================================================================
# .gitignore - Intelligent Resume-to-Job Matching System
# ==============================================================================

# --- 1. Python Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- 2. Python Bytecode & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# --- 3. Build & Packaging Artifacts ---
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- 4. Node.js & Web Dependencies (if applicable) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/

# --- 5. IDEs, Editors & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.claude/

# --- 6. Testing, Type Checking & Linting Caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
coverage/
nosetests.xml
coverage.xml
*.cover

# --- 7. Environment Variables & Secrets ---
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# --- 8. Machine Learning Models, Vector Indices & Large Generated Artifacts ---
# Precomputed vector indices, embeddings, and models (regenerated via scripts/build_index.py)
*.faiss
*.index
*.joblib
*.npz
*.npy
*.pkl
*.h5
*.onnx
data/cache/
data/indices/
models/

# --- 9. Temporary & Log Files ---
*.log
tmp/
temp/
*.tmp
*.bak

# --- 10. Jupyter Notebook Checkpoints ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- 11. Archive Files ---
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
data/all_job_post.csv
